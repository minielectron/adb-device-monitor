{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ADB Performance Studio",
  "version": "1.0.0",
  "identifier": "com.devicemonitor.adbperformancestudio",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "resources": ["resources/app.jar", "resources/runtime/**/*"],
    "macOS": {
      "minimumSystemVersion": "11.3",
      "entitlements": "entitlements.plist"
    }
  }
}
